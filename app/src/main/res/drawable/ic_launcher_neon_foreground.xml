<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing Cyber Neon Squircle -->
    <path
        android:pathData="M41,23 L67,23 A18,18 0 0 1 85,41 L85,67 A18,18 0 0 1 67,85 L41,85 A18,18 0 0 1 23,67 L23,41 A18,18 0 0 1 41,23 Z"
        android:strokeWidth="2.0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="23"
                android:startY="23"
                android:endX="85"
                android:endY="85"
                android:type="linear">
                <item android:offset="0.0" android:color="#F0180B28" />
                <item android:offset="0.5" android:color="#F50C051A" />
                <item android:offset="1.0" android:color="#FA030108" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="23"
                android:startY="23"
                android:endX="85"
                android:endY="85"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFA78BFA" />
                <item android:offset="0.5" android:color="#FF818CF8" />
                <item android:offset="1.0" android:color="#FFC084FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon Glow Dial ring -->
    <path
        android:pathData="M54,34 A20,20 0 1,0 54,74 A20,20 0 1,0 54,34 Z"
        android:strokeColor="#50A78BFA"
        android:strokeWidth="1.2" />

    <!-- Neon Clock Hands -->
    <!-- Hour Hand -->
    <path
        android:pathData="M54,54 L44,46"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- Minute Hand pointing to ~1:50 -->
    <path
        android:pathData="M54,54 L69,43"
        android:strokeColor="#A78BFA"
        android:strokeWidth="3.0"
        android:strokeLineCap="round" />

    <!-- Second Hand (Bright Cyan Needle) -->
    <path
        android:pathData="M54,54 L44,69"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.4"
        android:strokeLineCap="round" />

    <!-- Center Jewel Pin -->
    <path
        android:pathData="M54,52 A2,2 0 1,0 54,56 A2,2 0 1,0 54,52 Z"
        android:fillColor="#FFFFFF" />

</vector>
